{
  "name": "smart-replenishment",
  "version": "1.0.0",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10.1.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-products": "cds watch --open nw.replenish.products/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "Northwind": {
        "kind": "odata",
        "model": "srv/external/Northwind",
        "[development]": {
          "credentials": {
            "url": "https://services.odata.org/V4/Northwind/Northwind.svc"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "Northwind"
          }
        }
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/products"
  ]
}
